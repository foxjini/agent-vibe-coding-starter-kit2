# Vision Client Environment Variables Template

# FastAPI Backend URL (Local PC)
BACKEND_URL=http://localhost:8000

# Device Authentication Key (Must match backend DEVICE_API_KEY)
DEVICE_API_KEY=your_secret_device_api_key_here

# Camera Index (0 for default webcam, 1 for external USB camera)
CAMERA_INDEX=0

# 어떤 카메라를 쓸지 — auto(기본) | usb | picamera
#   auto     : Pi Camera를 먼저 시도하고, 없으면 USB 웹캠으로 넘어갑니다
#   usb      : USB 웹캠만 (cv2.VideoCapture)
#   picamera : 라즈베리파이 CSI 카메라만 (picamera2)
CAMERA_SOURCE=auto

# 감지 설정을 몇 초마다 서버에서 다시 받아올지
# (대시보드에서 감지 대상을 바꾸면 이 주기 안에 자동 반영됩니다)
CONFIG_POLL_SECONDS=5

# subway 팀만 — 웹캠 2대로 두 칸을 볼 때 이 창이 맡은 칸 (car_1 또는 car_2)
#   두 번째 창은 $env:CAMERA_INDEX="1"; $env:SUBWAY_CAR="car_2"; python main.py
#   자세한 순서: docs/11.4-subway-웹캠2대-혼잡도-비교-매뉴얼.html
# SUBWAY_CAR=car_1
#
# PC가 뜨겁거나 팬이 시끄러우면 (창을 2개 켤 때) — 먼저 /kit 영상인식 설정에서 쓰는 검출기만 켜고,
# 그래도 무거우면 아래 줄의 #을 지웁니다. 비워 두면 지금처럼 동작합니다.
#   DETECT_FPS : 검출기를 1초에 몇 번 돌릴지 (사람 수 세기는 2면 충분, 화면은 계속 매끄럽게 보임)
#   ORT_THREADS: 사람·사물 감지(YOLO)가 창마다 쓸 CPU 코어 수
#   CAMERA_WIDTH/HEIGHT: 카메라 해상도 (기본 640×480)
# DETECT_FPS=2
# ORT_THREADS=2
# CAMERA_WIDTH=320
# CAMERA_HEIGHT=240

# -----------------------------------------------------------------------------
# 무엇을 감지할지는 이 파일이 아닙니다.
#   대시보드 /kit → 영상인식 설정  (또는 자동화 규칙의 vision_label 트리거)
# 비전 코드(main.py)는 감지 대상을 모릅니다 — docs/부록F 10장
# -----------------------------------------------------------------------------
