# Backend Environment Variables Template

# App Mode ('mock' for simulator, 'hardware' for Raspberry Pi 5)
DEVICE_MODE=mock

# CORS allowed origins (comma-separated). Add your Vercel URL after deployment.
# Never use '*' here: it disables cross-origin protection for a credentialed API.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local MySQL/MariaDB Settings (XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_control
# Reused connections (keeps Pi polling + vision events from opening a new connection each call)
DB_POOL_SIZE=5

# Device Authentication Key (Share this key with vision/ and pi/)
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(24))"
DEVICE_API_KEY=your_secret_device_api_key_here

# 자동화 규칙의 schedule 트리거가 쓰는 시간대 (IANA 이름).
# 클라우드 서버는 UTC로 도므로 반드시 우리 지역을 지정하세요 — 안 그러면 알람이 9시간 밀립니다.
PLATFORM_TIMEZONE=Asia/Seoul

# 규칙 엔진이 schedule 트리거를 점검하는 주기(초)
RULE_TICK_SECONDS=20

# --- 기상 미션 설정은 여기가 아닙니다 ----------------------------------------
# 시나리오(가위바위보 판정·2차 수면 방지)는 프론트엔드가 맡으므로
# MISSION_* / WAKEUP_* 값은 frontend/.env.local 의 NEXT_PUBLIC_* 로 옮겨갔습니다.
# 자세한 내용: docs/부록F-IoT-개발-플랫폼-키트-규약.md 9장

# Supabase Settings (Week 4 - Cloud Migration)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# SUPABASE_URL=https://[PROJECT-ID].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=[SECRET-KEY]
