# Backend Environment Variables Template

# App Mode ('mock' for simulator, 'hardware' for Raspberry Pi 5)
DEVICE_MODE=mock

# CORS allowed origins (comma-separated). Add your Vercel URL after deployment.
# Never use '*' here: it disables cross-origin protection for a credentialed API.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Local MySQL/MariaDB Settings (XAMPP) - used when DATABASE_URL is empty
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_control

# Supabase (PostgreSQL) - Week 4 cloud migration.
# Set this and the backend switches to PostgreSQL automatically; the MySQL
# settings above are then ignored. Create the schema first by running
# backend/db/init_supabase.sql in the Supabase SQL Editor.
# Use the "Connection pooling" URI from Supabase (port 6543) for Render.
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[HOST]:6543/postgres

# ------------------------------------------------------------------
# Admin access control (see docs/부록G §3-4)
# ------------------------------------------------------------------
# Admin PIN. Guards device control and the forced scenario endpoints.
# CHANGE THIS BEFORE THE EXHIBITION - the default is published in the repo.
ADMIN_PIN=9179

# How long an admin session stays valid, in seconds (default 3600 = 1 hour).
ADMIN_TOKEN_TTL_SEC=3600

# Universal test PIN (1234) that opens the booth without a reservation.
# Convenient while developing; MUST stay false for the exhibition.
ALLOW_TEST_PIN=true

# Require a Bearer token on dashboard endpoints. Leave false unless you have
# actually set up Supabase Auth - turning it on without a login flow makes the
# whole dashboard return 401.
REQUIRE_USER_AUTH=false

# ------------------------------------------------------------------
# Devices
# ------------------------------------------------------------------
# Device Authentication Key (Share this key with vision/ and pi/)
DEVICE_API_KEY=your_secret_device_api_key_here

# Supabase project keys (only needed if you later add Supabase Auth)
# SUPABASE_URL=https://[PROJECT-ID].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=[SECRET-KEY]
