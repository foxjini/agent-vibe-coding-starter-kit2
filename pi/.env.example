# Raspberry Pi 5 Daemon Environment Variables Template
# (플랫폼 키트 공통 데몬 daemon.py 용. 부품 배치는 .env가 아니라 slot_map.py에 적습니다.)

# FastAPI Backend URL
# IMPORTANT: When running on Raspberry Pi, use your PC's Wi-Fi IP address (e.g., http://192.168.35.71:8000) or Render URL!
# Do NOT use 'localhost' because localhost refers to the Raspberry Pi itself.
BACKEND_URL=http://192.168.35.71:8000

# Device Authentication Key (Must match backend DEVICE_API_KEY)
# Never commit the real value. Generate one: python -c "import secrets; print(secrets.token_urlsafe(24))"
DEVICE_API_KEY=your_secret_device_api_key_here

# Device Mode: 'auto' (detects GPIO on Pi, falls back to simulation on PC), 'hardware', or 'mock'
#   auto     : 파이에서는 실기기, PC에서는 흉내내기 — 기본값
#   hardware : 반드시 실기기. GPIO를 열지 못하면 오류를 크게 남깁니다
#   mock     : 파이에서도 흉내내기 (배선 없이 화면만 확인할 때)
DEVICE_MODE=auto

# GPIOZERO Pin Factory (lgpio is required for Raspberry Pi 5 RP1 chipset)
GPIOZERO_PIN_FACTORY=lgpio

# --- 통신 주기 ---------------------------------------------------------------
# 슬롯 전체를 한 번에 폴링하는 주기 (초)
POLL_INTERVAL_SECONDS=1.0
# 상태가 바뀌지 않아도 현재 상태를 다시 보고하는 주기
# (백엔드가 재시작되어 상태가 초기화돼도 자동으로 맞춰집니다)
RESYNC_INTERVAL_SECONDS=30
# 백엔드가 꺼져 있을 때 배치표 등록을 다시 시도하는 주기
REGISTER_RETRY_SECONDS=10
# HTTP 요청 하나를 포기하기까지의 시간
REQUEST_TIMEOUT_SECONDS=3.0

# 로그 수준 (INFO / DEBUG)
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 핀 번호·부저 종류·버튼 극성은 이 파일이 아니라 slot_map.py에 적습니다.
#   부품 추가 → slot_map.py에 한 줄 추가
#   부품 제거 → slot_map.py에서 한 줄 삭제
# 배선을 확인만 하려면: python daemon.py --check
# -----------------------------------------------------------------------------
