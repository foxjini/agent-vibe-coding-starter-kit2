# Raspberry Pi 5 Daemon Environment Variables Template

# FastAPI Backend URL
# IMPORTANT: When running on Raspberry Pi, use your PC's IP address (e.g., http://192.168.0.25:8000) or Render URL!
# Do NOT use 'localhost' because localhost refers to the Raspberry Pi itself.
BACKEND_URL=http://192.168.0.100:8000

# Device Authentication Key (Must match backend DEVICE_API_KEY)
DEVICE_API_KEY=your_secret_device_api_key_here

# Polling interval in seconds. Shorter = the booth reacts faster to dashboard
# buttons, but puts more load on the backend. 2~5 seconds is the usual range.
POLL_INTERVAL_SEC=3.0

# GPIOZERO Pin Factory (lgpio is required for Raspberry Pi 5 RP1 chipset)
GPIOZERO_PIN_FACTORY=lgpio

# Who plays the booth audio?
#   browser (default) - the booth web page speaks the welcome / closing track.
#                       The Pi does not touch speaker_1 at all.
#   pi                - the Pi reads the message aloud through its own speaker
#                       using espeak-ng (sudo apt install -y espeak-ng).
#                       Then turn the booth page's voice off (bottom-left button
#                       on /booth) so announcements are not played twice.
SPEAKER_MODE=browser

# Relay board polarity.
# Many cheap relay boards are LOW-level trigger (LOW = relay ON). If yours is,
# set this to false, otherwise the door lock and the 220V relay switch ON the
# moment a script starts. Check with test_hardware_gpio.py before wiring 220V.
RELAY_ACTIVE_HIGH=true
