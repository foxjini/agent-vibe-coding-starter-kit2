# Frontend Environment Variables Template

# FastAPI Backend URL (Local development)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# After deploying to Vercel, point these at the Render backend.
# HTTPS pages can only open 'wss://' sockets - 'ws://' is blocked by the browser.
# NEXT_PUBLIC_API_BASE_URL=https://[SERVICE].onrender.com
# NEXT_PUBLIC_WS_URL=wss://[SERVICE].onrender.com/ws

# Supabase Public Keys (Week 4 - Cloud Migration)
# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-ID].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=[ANON-KEY]

# --- 기상 미션 설정 (시나리오가 프론트엔드로 옮겨오면서 여기로 왔습니다) ---
# 값을 바꾸면 코드 수정 없이 미션 난이도가 바뀝니다.
# rps = 가위바위보만, object = 사물/사람 감지만, auto = 둘 다 (기본)
NEXT_PUBLIC_MISSION_MODE=auto
NEXT_PUBLIC_MISSION_REQUIRED_WINS=2
NEXT_PUBLIC_MISSION_ROUND_TIMEOUT_SECONDS=15
NEXT_PUBLIC_MISSION_MIN_CONFIDENCE=0.6
# 새 라운드 직후 유예 시간 — 직전 손이 다시 들어와 억울하게 지는 것을 막습니다
NEXT_PUBLIC_MISSION_ROUND_GRACE_SECONDS=2
NEXT_PUBLIC_MISSION_OBJECT_TARGETS=person,bottle,cup,book,cell phone
NEXT_PUBLIC_MISSION_OBJECT_REQUIRED_HITS=2
# 2차 수면 방지: 미션 성공 후 확인 팝업까지의 시간과, 확인을 기다리는 시간
NEXT_PUBLIC_WAKEUP_POPUP_DELAY_SECONDS=25
NEXT_PUBLIC_WAKEUP_CONFIRM_TIMEOUT_SECONDS=15
